# ── LLM ──────────────────────────────────────────────
# Public API/UI default: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
OPENAI_GENERATION_MODEL=gpt-5.6-luna
LLM_FALLBACK_ENABLED=true
# Legacy active-provider override; leave empty to use the provider-specific model above.
GENERATION_MODEL=
JUDGE_MODEL=

# Retained for non-public CLI/evaluation compatibility.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Deployment mode ─────────────────────────────────
# standard = owner-managed local/server credentials
# public_byok = each visitor supplies one request-scoped Gemini/OpenAI key;
# never set GEMINI_API_KEY or OPENAI_API_KEY in a public BYOK Space.
DEPLOYMENT_MODE=standard
SESSION_SIGNING_SECRET=
BYOK_SESSION_QUERY_LIMIT=20
BYOK_SESSION_TTL_SECONDS=86400
BYOK_MAX_CONCURRENCY=2
BYOK_REQUEST_TIMEOUT_SECONDS=60
BYOK_MAX_QUESTION_CHARS=2000

# ── Embedding / Reranker ─────────────────────────────
# auto | cuda | cpu
DEVICE=auto

# ── Qdrant ───────────────────────────────────────────
# local = in-process file mode (no Docker needed) | server = docker-compose Qdrant
QDRANT_MODE=local
QDRANT_PATH=storage/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_SECONDS=60
# In public_byok this must be a collection-scoped read-only runtime key.
QDRANT_API_KEY=
